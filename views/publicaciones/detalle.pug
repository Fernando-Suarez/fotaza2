extends ../layout

block content

    .row

        .col-md-8

            .card.shadow

                if publicacion.Fotografia && publicacion.Fotografia.length > 0

                    img.card-img-top(
                        src=`/fotografias/${publicacion.Fotografia[0].id}`
                        alt=publicacion.titulo
                    )

                .card-body

                    h2= publicacion.titulo

                    p.text-muted
                        | Autor:
                        = publicacion.Usuario ? publicacion.Usuario.nombre : 'Desconocido'

                    p
                        = publicacion.descripcion

                    hr

                    h5 Valoración promedio

                    p
                        = promedio || 0
                        |  ⭐

                    hr
                    if user

                    h5 Valorar fotografía

                        form(action="/valoraciones" method="POST")

                            input(
                                type="hidden"
                                name="fotografia_id"
                                value=publicacion.Fotografia[0].id
                            )

                            input(
                                type="hidden"
                                name="publicacion_id"
                                value=publicacion.id
                            )

                            select.form-select.mb-3(
                                name="puntaje"
                                required
                            )
                                option(value="") Seleccione una puntuación
                                option(value="1") 1 ⭐
                                option(value="2") 2 ⭐⭐
                                option(value="3") 3 ⭐⭐⭐
                                option(value="4") 4 ⭐⭐⭐⭐
                                option(value="5") 5 ⭐⭐⭐⭐⭐

                            button.btn.btn-warning(type="submit")
                                | Valorar
                    hr

                    h5 Etiquetas

                    if publicacion.Etiqueta

                        each etiqueta in publicacion.Etiqueta

                            span.badge.bg-primary.me-1
                                = etiqueta.titulo

                    hr

                    h5 Comentarios

                    if comentarios && comentarios.length > 0

                        each comentario in comentarios

                            .border.rounded.p-2.mb-2

                                strong
                                    = comentario.Usuario.nombre

                                p.mb-0
                                    = comentario.texto

                    else

                        p.text-muted
                            | Todavía no hay comentarios.

                    if user

                        hr

                        form(
                            action="/comentarios"
                            method="POST"
                        )

                            input(
                                type="hidden"
                                name="fotografia_id"
                                value=publicacion.Fotografia[0].id
                            )

                            input(
                                type="hidden"
                                name="publicacion_id"
                                value=publicacion.id
                            )

                            .mb-3

                                textarea.form-control(
                                    name="texto"
                                    rows="3"
                                    placeholder="Escribe un comentario..."
                                    required
                                )

                            button.btn.btn-primary(type="submit")
                                | Comentar

