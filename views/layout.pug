doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Fotaza 2

        // Bootstrap 5
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css",
            rel="stylesheet"
        )

        // Bootstrap Icons
        link(
            rel="stylesheet",
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        )



    body.bg-light

        nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
            .container

                a.navbar-brand(href="/")
                    i.bi.bi-camera.m-1
                    | Fotaza 2

                button.navbar-toggler(
                    type="button",
                    data-bs-toggle="collapse",
                    data-bs-target="#navbarNav"
                )
                    span.navbar-toggler-icon

                #navbarNav.collapse.navbar-collapse

                    ul.navbar-nav.me-auto

                        li.nav-item
                            a.nav-link(href="/") Home

                        li.nav-item
                            a.nav-link(href="/publicaciones") Publicaciones

                        li.nav-item
                            a.nav-link(href="/buscar") Buscar

                        li.nav-item
                            a.nav-link(href="/notificaciones") Notificaciones

                    ul.navbar-nav.ms-auto

                        if user

                            li.nav-item
                                a.nav-link(href="/publicaciones/crear")
                                    i.bi.bi-plus-circle
                                    |  Crear

                            li.nav-item
                                a.nav-link(href="/perfil")
                                    i.bi.bi-person-circle
                                    |  #{user.nombre}

                            li.nav-item
                                a.nav-link.text-danger(href="/logout")
                                    i.bi.bi-box-arrow-right
                                    |  Salir

                        else

                            li.nav-item
                                a.nav-link(href="/auth/login")
                                    | Login

                            li.nav-item
                                a.nav-link(href="/auth/signup")
                                    | Registro

        // CONTENIDO PRINCIPAL

        .container.mt-4

            if success
                .alert.alert-success
                    | #{success}

            if error
                .alert.alert-danger
                    | #{error}

            block content


        // FOOTER

        footer.text-center.mt-5.mb-3.text-muted
            small
                | Fotaza 2 - Programación Web II

        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        )